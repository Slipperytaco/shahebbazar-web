# Backend (Express API) -- local development.
#
# These match docker-compose.yml at the repo root. Start the database with
# `docker compose up -d` from there; no local PostgreSQL install needed.

PGHOST=localhost
PGUSER=postgres
PGPASSWORD=Hiruna2002!
PGDATABASE=shahebbazar
PGPORT=5432

# Port the API listens on.
PORT=4000

# Browser origins allowed to call this API. Comma-separated, no wildcard --
# once a session cookie exists, a wildcard lets any site read it.
CORS_ORIGIN=http://localhost:3000
